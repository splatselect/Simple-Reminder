<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Simple Reminder</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" />
  </ItemGroup>

  <Target Name="SignOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="signtool sign /f &quot;$(SigningCertPath)&quot; /p &quot;$(SigningCertPassword)&quot; /fd SHA256 /tr http://timestamp.certum.pl /td SHA256 &quot;$(PublishDir)Simple Reminder.exe&quot;"
          Condition="'$(SigningCertPath)' != ''" />
  </Target>

</Project>
